# URI de conexão com o MongoDB.
# Transações do MongoDB exigem um replica set. Em Atlas isso já é padrão.
# Para desenvolvimento local, use o docker-compose.yml na raiz (sobe o MongoDB como replica set rs0).
# Para produção, substitua pela URI do MongoDB Atlas.
MONGO_URI=mongodb://localhost:27017/commerce_api_dev?replicaSet=rs0

# URI de conexão com o banco de testes (usado pelos testes de integração).
# Exemplo: mongodb://localhost:27017/commerce_api_test?replicaSet=rs0
MONGO_URI_TEST=mongodb://localhost:27017/commerce_api_test?replicaSet=rs0

# Chave secreta usada para assinar os tokens JWT. Use um valor forte e aleatório em produção.
JWT_SECRET=senha_super_secreta

# Origens permitidas pelo CORS. Separe múltiplas origens com vírgula.
# Exemplo: http://localhost:3000,https://meudominio.com
CORS_URL=http://localhost:3000

# Tempo de duração da sessão JWT. Após expirar, o usuário deve fazer login novamente.
JWT_EXPIRES_IN=7d

# Porta onde a API será executada.
PORT=3001

# Credenciais do usuário master criado automaticamente pelo seed.
# Este usuário possui acesso total ao sistema e não pertence a nenhum tenant.
MASTER_EMAIL=master@admin.com
MASTER_PASSWORD=master123

# Credenciais do usuário admin criado automaticamente pelo seed.
ADMIN_EMAIL=admin@lojaexemplo.com
ADMIN_PASSWORD=admin123

# Credenciais do usuário comum criado automaticamente pelo seed.
USER_EMAIL=user@lojaexemplo.com
USER_PASSWORD=user123
