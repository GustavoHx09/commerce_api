# URI de conexão com o MongoDB.
# Transações do MongoDB exigem um replica set. Em Atlas isso já é padrão.
# Para desenvolvimento local, use o docker-compose.yml na raiz (sobe o MongoDB como replica set rs0).
# Para produção, substitua pela URI do MongoDB Atlas.
# No MongoDB Compass, prefira 127.0.0.1 e directConnection=true para evitar timeout com um nó só:
# mongodb://127.0.0.1:27017/commerce_api_dev?replicaSet=rs0&directConnection=true
MONGO_URI=mongodb://localhost:27017/commerce_api_dev?replicaSet=rs0

# URI de conexão com o banco de testes (usado pelos testes de integração).
# Exemplo: mongodb://localhost:27017/commerce_api_test?replicaSet=rs0
MONGO_URI_TEST=mongodb://localhost:27017/commerce_api_test?replicaSet=rs0

# Chave secreta usada para assinar os tokens JWT. Use um valor forte e aleatório em produção.
JWT_SECRET=senha_super_secreta

# Origens permitidas pelo CORS. Separe múltiplas origens com vírgula.
# Exemplo: http://localhost:3000,https://meudominio.com
CORS_URL=http://localhost:3000

# DSN usado para enviar erros da API ao Sentry. Deixe vazio para desabilitar a integração.
SENTRY_DSN=

# Tempo de duração da sessão JWT. Após expirar, o usuário deve fazer login novamente.
JWT_EXPIRES_IN=7d

# Porta onde a API será executada.
PORT=3001

# Credenciais do usuário master criado automaticamente pelo seed.
# Este usuário possui acesso total ao sistema e não pertence a nenhum tenant.
MASTER_EMAIL=master@admin.com
MASTER_PASSWORD=master123

# Credenciais do usuário admin criado automaticamente pelo seed.
ADMIN_EMAIL=admin@lojaexemplo.com
ADMIN_PASSWORD=admin123

# Credenciais do usuário comum criado automaticamente pelo seed.
USER_EMAIL=user@lojaexemplo.com
USER_PASSWORD=user123

# Chave da API do Resend (resend.com) para envio de emails transacionais.
# Deixe vazio enquanto a conta não estiver criada: os envios serão ignorados
# e a recuperação de senha ficará indisponível de fato, sem quebrar a API.
RESEND_API_KEY=

# Remetente dos emails transacionais. Em produção exige domínio verificado no Resend.
# Exemplo: EMAIL_FROM="Commerce API <noreply@seudominio.com>"
EMAIL_FROM=onboarding@resend.dev

# URL base do frontend, usada para montar o link de recuperação de senha.
WEB_URL=http://localhost:3000

# Object storage para uploads (logos). Compatível com AWS S3, Cloudflare R2 e MinIO.
# Deixe S3_BUCKET vazio em desenvolvimento para gravar os uploads no disco local (./uploads).
# Exemplo Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
# Exemplo MinIO local:
#   S3_ENDPOINT=http://localhost:9000
#   S3_REGION=us-east-1
# Exemplo AWS S3: deixe S3_ENDPOINT vazio e use a região do bucket (ex: us-east-1).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# URL pública base do bucket, usada para montar o link dos arquivos.
# Exemplos: https://pub-<id>.r2.dev (R2 com acesso público) | https://<bucket>.s3.<regiao>.amazonaws.com
S3_PUBLIC_URL=
