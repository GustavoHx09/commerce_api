# Exemplo de variáveis de ambiente para desenvolvimento.
# Copie este arquivo para .env e preencha os valores reais.

# Conexão com o MongoDB.
MONGO_URI=mongodb://localhost:27017/commerce_api_dev

# Chave secreta para assinar JWT. Deve ser forte e ter pelo menos 32 caracteres.
JWT_SECRET=substitua_por_uma_chave_forte_de_pelo_menos_32_caracteres

# Origem permitida pelo CORS. Em dev: http://localhost:3000
# Pode passar múltiplas origens separadas por vírgula.
CORS_URL=http://localhost:3000

# Tempo de expiração do token JWT (ex: 1h, 1d, 7d).
JWT_EXPIRES_IN=7d

# Credenciais do usuário master criado pelo seed.
MASTER_EMAIL=master@admin.com
MASTER_PASSWORD=

# Credenciais do administrador de exemplo criado pelo seed.
ADMIN_EMAIL=admin@lojaexemplo.com
ADMIN_PASSWORD=

# Credenciais do usuário comum de exemplo criado pelo seed.
USER_EMAIL=user@lojaexemplo.com
USER_PASSWORD=
